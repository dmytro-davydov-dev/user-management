// User management data model. Connection URL lives in prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  loginsCount  Int        @default(0) @map("logins_count")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]

  // Stable ordering for pagination: ORDER BY created_at DESC, id DESC
  @@index([createdAt, id])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  terminatedAt DateTime? @map("terminated_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)

  // Deleting a user removes its sessions, so they can no longer authenticate.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, terminatedAt])
  @@map("sessions")
}
