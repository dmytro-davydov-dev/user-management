# --- Database ---
POSTGRES_PASSWORD=localdev
# Used by the API and Prisma (host-side dev uses localhost; Compose overrides to db)
DATABASE_URL=postgresql://app:localdev@localhost:5432/user_management

# --- API ---
API_PORT=4000
SESSION_TTL_HOURS=24

# --- Web (server-only; never exposed to the browser) ---
API_INTERNAL_URL=http://localhost:4000
# Set to true behind HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false
