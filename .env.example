# --- Database ---
POSTGRES_PASSWORD=localdev
# Host port for the Compose db service
POSTGRES_PORT=5433
# Used by the API and Prisma (host-side dev uses localhost; Compose overrides to db)
DATABASE_URL=postgresql://app:localdev@localhost:5433/user_management

# --- API ---
API_PORT=4000
SESSION_TTL_HOURS=24

# --- Web (server-only; never exposed to the browser) ---
API_INTERNAL_URL=http://localhost:4000
# Set to true behind HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false

# --- Dev seed only (`pnpm --filter api db:seed`; refuses NODE_ENV=production) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-locally
